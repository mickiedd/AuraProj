# Unreal Engine generated output
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/
/ProjectFiles/
/Plugins/**/Binaries/
/Plugins/**/Intermediate/
/Plugins/**/Temp/
# Per-developer IDE tooling plugins (e.g. JetBrains RiderLink) — auto-installed, not shared.
/Plugins/Developer/

# Generated build/package artifacts
/Build/**/FileOpenOrder/
/Build/WindowsNoEditor/

# IDE and editor local state
/.vs/
/.idea/
/Content/*
!/Content/Blueprints/
!/Content/Assets/
!/Content/Config/
!/Content/BehaviorTrees/
!/Content/AbilityDefinitions/
# Project maps (Login is the GameDefaultMap and must be shared so others can run).
!/Content/Maps/
# Assets referenced by RoleConfig.json / C++ code and required to run roles, the car, and levels.
!/Content/BungeeMan/
!/Content/MilitaryWeapDark/
!/Content/Cartoon_City_Free/
!/Content/Fantastic_Dungeon_Pack/
!/Content/Scifi_desert_city/
# Transient reload-sentinel written by the editor "Reload Role Config" mending tool.
/Content/Config/.RoleConfig.reload
/Platforms/
*.VC.db
*.VC.opendb
*.opensdf
*.opendb
*.sdf
*.sln
*.suo
*.user
*.userprefs
*.code-workspace
.vsconfig

# Platform/editor noise
.DS_Store
Thumbs.db
Desktop.ini

# Xcode project files
*.xcodeproj
*.xcworkspace
/enc_temp_folder
*.log
*.old
*.dat
/Scripts/__pycache__
/Plugins/BehaviorU/BehaviorULauncher/WebView2UserData
/Plugins/BehaviorU/BehaviorULauncher/packages
/Plugins/BehaviorU/BehaviorULauncher/build
/Plugins/BehaviorU/BehaviorULauncher/.vs
/Plugins/BehaviorU/BehaviorULauncher/*.exe
/Plugins/BehaviorU/BehaviorULauncher/*.pdb
/Plugins/BehaviorU/BehaviorULauncher/*WebView2Loader.dll
/Plugins/AuraAbilityGraph/AuraAbilityGraphLauncher/WebView2UserData
/Plugins/AuraAbilityGraph/AuraAbilityGraphLauncher/packages
/Plugins/AuraAbilityGraph/AuraAbilityGraphLauncher/build
/Plugins/AuraAbilityGraph/AuraAbilityGraphLauncher/.vs
/Plugins/AuraAbilityGraph/AuraAbilityGraphLauncher/*.exe
/Plugins/AuraAbilityGraph/AuraAbilityGraphLauncher/*.pdb
/Plugins/AuraAbilityGraph/AuraAbilityGraphLauncher/*WebView2Loader.dll
__pycache__/
