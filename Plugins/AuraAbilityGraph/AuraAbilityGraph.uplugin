{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "1.0",
  "FriendlyName": "Aura Ability Graph",
  "Description": "Data-driven ability system for Aura",
  "Category": "Aura",
  "Plugins": [
    {
      "Name": "GameplayAbilities",
      "Enabled": true
    },
    {
      "Name": "Niagara",
      "Enabled": true
    },
    {
      "Name": "EditorScriptingUtilities",
      "Enabled": true,
      "TargetAllowList": [ "Editor" ]
    }
  ],
  "Modules": [
    {
      "Name": "AuraAbilityGraph",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "Dependencies": [ "GameplayAbilities", "Niagara" ]
    },
    {
      "Name": "AuraAbilityGraphEditor",
      "Type": "Editor",
      "LoadingPhase": "Default",
      "Dependencies": [ "AuraAbilityGraph", "EditorScriptingUtilities" ]
    }
  ]
}
