<?xml version="1.0" encoding="utf-8"?>
<ability name="Electrocute" abilityTag="Abilities.Lightning.Electrocute" inputTag="InputTag.3" type="Abilities.Type.Offensive">
  <cost mana="5"/>
  <cooldown tag="Cooldown.Lightning.Electrocute" duration="3"/>
  <damage effectClass="" type="Damage.Lightning" base="10" debuffChance="0.5" debuffDamage="2" debuffDuration="3" debuffFrequency="0.5" deathImpulseMagnitude="1000" knockbackForceMagnitude="500" knockbackChance="0.1"/>
  <graph>
    <node class="Sequence">
      <node class="WaitForTargetData">
        <property name="MaxTargetDistance" value="3000"/>
      </node>
      <node class="FaceTarget">
        <property name="bSetControllerRotation" value="false"/>
        <property name="bSetActorRotation" value="true"/>
        <property name="bYawOnly" value="true"/>
      </node>
      <node class="PlayMontage">
        <property name="Montage" value="/Game/Assets/Characters/Aura/Animations/Abilities/AM_Cast_Electrocute.AM_Cast_Electrocute"/>
      </node>
      <node class="WaitForMontageEvent">
        <property name="EventTag" value="Event.Montage.Electrocute"/>
        <!-- Dedicated servers may not receive the local montage event; never leave the ability active forever. -->
        <property name="Timeout" value="5"/>
        <!-- The server owns beam gameplay; do not block it on a client-local montage notify. -->
        <property name="AuthorityFallbackDelay" value="0.35"/>
      </node>

      <!-- Beam setup -->
      <node class="ResolveBeamOrigin">
        <property name="SocketTag" value="CombatSocket.Weapon"/>
        <property name="MaxRange" value="3000"/>
      </node>
      <node class="AcquirePrimaryBeamTarget">
        <!-- Uses the activation cursor hit; falls back to a forward sphere trace. -->
        <property name="TraceRadius" value="10"/>
        <property name="MaxRange" value="3000"/>
        <property name="AllowVisualOnlyEndpoint" value="true"/>
      </node>
      <node class="SelectBeamChainTargets">
        <!-- Selects ability-level-minus-one targets once; the channel keeps this set. -->
        <property name="SearchRadius" value="850"/>
        <property name="MaxAdditionalTargets" value="5"/>
      </node>

      <!-- Beam visuals -->
      <node class="SpawnBeamVisuals">
        <property name="BeamEffect" value="/Game/Assets/Effects/Shock/NS_ElectricBeam.NS_ElectricBeam"/>
        <property name="BeamStartParameter" value="User.Beam Start"/>
        <property name="BeamEndParameter" value="User.Beam End"/>
      </node>
      <node class="InitializeBeamEndpoints">
        <property name="BeamStartParameter" value="User.Beam Start"/>
        <property name="BeamEndParameter" value="User.Beam End"/>
      </node>

      <!-- Channeled execution -->
      <node class="TimedLoop">
        <property name="Duration" value="2"/>
        <property name="Interval" value="0.2"/>
        <property name="ExecuteImmediately" value="true"/>
        <property name="CleanupBeamStateOnCancel" value="true"/>
        <node class="Sequence">
          <node class="PruneBeamTargets"/>
          <node class="RefreshBeamEndpoints">
            <property name="BeamStartParameter" value="User.Beam Start"/>
            <property name="BeamEndParameter" value="User.Beam End"/>
          </node>
          <node class="ApplyBeamDamage">
            <property name="AuthorityOnly" value="true"/>
          </node>
        </node>
      </node>

      <!-- Cleanup -->
      <node class="DestroyBeamVisuals"/>

      <!-- The legacy ElectrocuteBeam node is intentionally no longer used. -->
      <!--
      <node class="ElectrocuteBeam">
        <property name="MaxBeamRange" value="3000"/>
        <property name="BeamStartParameter" value="User.Beam Start"/>
        <property name="BeamEndParameter" value="User.Beam End"/>
      </node>
      -->
    </node>
  </graph>
</ability>
